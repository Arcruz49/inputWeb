# Renderizado pelo entrypoint do nginx (envsubst) — só ${API_URL} é substituído,
# graças ao NGINX_ENVSUBST_FILTER definido no Dockerfile. As variáveis do próprio
# nginx ($uri, $host, ...) passam intactas.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Vídeo de captura passa fácil dos limites padrão.
    client_max_body_size 2g;
    client_body_timeout 600s;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # A API vive atrás de /api/ para o browser tratar o cookie inputweb_token
    # como first-party. A barra final no proxy_pass remove o prefixo /api.
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_http_version 1.1;

        # $proxy_host (e não $host): quando API_URL aponta para um domínio externo
        # — Container Apps, por exemplo — o ingress precisa do Host dele para rotear.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # Upload grande vai direto para a API, sem bufferizar em disco.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: qualquer rota desconhecida cai no index.html do React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
